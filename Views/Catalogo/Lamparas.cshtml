@model AlmaDelMarPampeano.ViewModels.CatalogoViewModel

@{
    var seleccionada = Model.Colecciones.FirstOrDefault(c => c.Id == Model.ColeccionId);
    ViewData["Title"] = seleccionada != null ? $"Lámparas · {seleccionada.Nombre}" : "Lámparas";
}

<h1 class="mb-1">@(seleccionada != null ? $"Lámparas · {seleccionada.Nombre}" : "Todas las lámparas")</h1>
<p class="seccion-sub">Pasá las fotos con las flechas para ver cada pieza desde distintos ángulos.</p>

<ul class="nav nav-pills flex-wrap gap-2 mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.ColeccionId == null ? "active" : "")" asp-action="Lamparas">Todas</a>
    </li>
    @foreach (var coleccion in Model.Colecciones)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.ColeccionId == coleccion.Id ? "active" : "")"
               asp-action="Lamparas" asp-route-coleccionId="@coleccion.Id">@coleccion.Nombre</a>
        </li>
    }
</ul>

@if (!Model.Lamparas.Any())
{
    <div class="alert alert-info">Todavía no hay lámparas cargadas en esta colección.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var lampara in Model.Lamparas)
        {
            <div class="col">
                <partial name="_LamparaTarjeta" model="lampara" />
            </div>
        }
    </div>
}

<div class="cuaderno-tarjeta mt-5">
    <h3>¿Querés algo distinto?</h3>
    <p class="mb-3">Armamos una lámpara a medida: elegís la campana, la base y el tipo de luz.</p>
    <a asp-controller="Pedidos" asp-action="Pedir" class="btn btn-outline-primary">Pedir una lámpara a medida</a>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al inicio</a>
</div>