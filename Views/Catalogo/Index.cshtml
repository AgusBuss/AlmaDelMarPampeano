@model AlmaDelMarPampeano.ViewModels.CatalogoViewModel

@{
    ViewData["Title"] = "Catálogo";
    var seleccionada = Model.Colecciones.FirstOrDefault(c => c.Id == Model.ColeccionId);
    var conCuaderno = Model.Colecciones.Where(c => !string.IsNullOrEmpty(c.RutaCuaderno)).ToList();
}

@* ===== 1. PORTADA ===== *@
<section class="portada">
    <div class="portada-contenido">
        <img src="~/img/logo-principal.png" alt="Alma del Mar Pampeano" class="portada-logo" />
        <h1 class="portada-lema">La luz de un antiguo mar que aún habita esta tierra.</h1>
        <p class="portada-texto">Lámparas artesanales de roca, fósil y madera pampeana. Cada pieza es única.</p>
        <div class="d-flex flex-wrap gap-2">
            <a href="#lamparas" class="btn btn-light btn-lg">Ver lámparas</a>
            <a href="#cuadernos" class="btn btn-outline-light btn-lg">Cuadernos de colección</a>
        </div>
    </div>
</section>

@* ===== 2. COLECCIONES ===== *@
<section id="colecciones" class="seccion">
    <h2 class="seccion-titulo">Nuestras colecciones</h2>
    <p class="seccion-sub">Tres historias, tres luces. Elegí una para ver sus lámparas.</p>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var c in Model.Colecciones)
        {
            var activa = Model.ColeccionId == c.Id;
            <div class="col">
                <a asp-action="Index" asp-route-coleccionId="@c.Id" asp-fragment="lamparas"
                   class="coleccion-tarjeta @(activa ? "activa" : "")">
                    <h3>@c.Nombre</h3>
                    @if (!string.IsNullOrEmpty(c.Descripcion))
                    {
                        <p>@c.Descripcion</p>
                    }
                    <span class="coleccion-ir">Ver lámparas &rarr;</span>
                </a>
            </div>
        }
    </div>
</section>

@* ===== 3. LÁMPARAS ===== *@
<section id="lamparas" class="seccion">
    <h2 class="seccion-titulo">@(seleccionada != null ? $"Lámparas · {seleccionada.Nombre}" : "Todas las lámparas")</h2>
    <p class="seccion-sub">Pasá las fotos con las flechas para ver cada pieza desde distintos ángulos.</p>

    <ul class="nav nav-pills flex-wrap gap-2 mb-4">
        <li class="nav-item">
            <a class="nav-link @(Model.ColeccionId == null ? "active" : "")" asp-action="Index" asp-fragment="lamparas">Todas</a>
        </li>
        @foreach (var coleccion in Model.Colecciones)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.ColeccionId == coleccion.Id ? "active" : "")"
                   asp-action="Index" asp-route-coleccionId="@coleccion.Id" asp-fragment="lamparas">@coleccion.Nombre</a>
            </li>
        }
    </ul>

    @if (!Model.Lamparas.Any())
    {
        <div class="alert alert-info">Todavía no hay lámparas cargadas en esta colección.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var lampara in Model.Lamparas)
            {
                var fotos = lampara.Fotos.OrderBy(f => f.Orden).ToList();
                var idCarrusel = $"carrusel-{lampara.Id}";

                <div class="col">
                    <div class="card h-100 shadow-sm">

                        @if (fotos.Count > 1)
                        {
                            @* Pasarela de fotos: flechas y puntitos para pasar entre ellas *@
                            <div id="@idCarrusel" class="carousel slide" data-bs-interval="false">
                                <div class="carousel-indicators">
                                    @for (var i = 0; i < fotos.Count; i++)
                                    {
                                        <button type="button" data-bs-target="#@idCarrusel" data-bs-slide-to="@i"
                                                class="@(i == 0 ? "active" : "")" aria-label="Foto @(i + 1)"></button>
                                    }
                                </div>
                                <div class="carousel-inner">
                                    @for (var i = 0; i < fotos.Count; i++)
                                    {
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="@fotos[i].RutaArchivo" class="d-block w-100"
                                                 style="height:280px;object-fit:cover;"
                                                 alt="@lampara.Nombre, foto @(i + 1)" />
                                        </div>
                                    }
                                </div>
                                <button class="carousel-control-prev" type="button" data-bs-target="#@idCarrusel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Foto anterior</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#@idCarrusel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Foto siguiente</span>
                                </button>
                            </div>
                        }
                        else if (fotos.Count == 1)
                        {
                            <img src="@fotos[0].RutaArchivo" class="card-img-top"
                                 style="height:280px;object-fit:cover;" alt="@lampara.Nombre" />
                        }
                        else
                        {
                            <div class="bg-light text-muted d-flex align-items-center justify-content-center"
                                 style="height:280px;">
                                Sin fotos
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h3 class="h5 card-title mb-1">@lampara.Nombre</h3>
                                @if (lampara.Disponible)
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Vendida</span>
                                }
                            </div>

                            <p class="text-muted small mb-2">
                                @if (lampara.NumeroPieza != null)
                                {
                                    <text>Pieza N.º @lampara.NumeroPieza · </text>
                                }
                                @lampara.Coleccion?.Nombre
                            </p>

                            <p class="small mb-2">
                                <strong>Campana:</strong> @(lampara.MaterialCampana?.Nombre ?? "—")<br />
                                <strong>Base:</strong> @(lampara.MaterialBase?.TipoMaterial ?? "—")
                            </p>

                            @if (!string.IsNullOrWhiteSpace(lampara.Descripcion))
                            {
                                <p class="card-text">@lampara.Descripcion</p>
                            }
                        </div>

                        <div class="card-footer bg-transparent d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span class="fs-5 fw-semibold">$ @lampara.Precio.ToString("N2")</span>
                            @if (lampara.Disponible)
                            {
                                <a asp-controller="Pedidos" asp-action="Pedir" asp-route-lamparaId="@lampara.Id"
                                   class="btn btn-primary">Quiero esta lámpara</a>
                            }
                            else
                            {
                                <span class="text-muted small">Pieza vendida</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="cuaderno-tarjeta mt-5">
        <h3>¿Querés algo distinto?</h3>
        <p class="mb-3">Armamos una lámpara a medida: elegís la campana, la base y el tipo de luz.</p>
        <a asp-controller="Pedidos" asp-action="Pedir" class="btn btn-outline-primary">Pedir una lámpara a medida</a>
    </div>
</section>

@* ===== 4. CUADERNOS ===== *@
@if (conCuaderno.Any())
{
    <section id="cuadernos" class="seccion">
        <h2 class="seccion-titulo">Cuadernos de colección</h2>
        <p class="seccion-sub">La historia, los materiales y el origen de cada pieza, en un cuaderno por colección.</p>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var c in conCuaderno)
            {
                <div class="col">
                    <div class="cuaderno-tarjeta">
                        <svg class="cuaderno-icono" viewBox="0 0 24 24" width="40" height="40" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 3h8l4 4v14H6z" />
                            <path d="M14 3v4h4" />
                            <path d="M9 12h6M9 16h6" />
                        </svg>
                        <h3>@c.Nombre</h3>
                        <p class="text-muted small">Cuaderno en PDF</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <a href="@c.RutaCuaderno" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Ver</a>
                            <a href="@c.RutaCuaderno" download class="btn btn-sm btn-primary">Descargar</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}