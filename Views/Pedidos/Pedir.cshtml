@model AlmaDelMarPampeano.ViewModels.PedidoNuevoViewModel

@{
    var esPieza = Model.Lampara != null;
    ViewData["Title"] = esPieza ? "Quiero esta lámpara" : "Pedir una lámpara a medida";
    var foto = Model.Lampara?.Fotos.OrderBy(f => f.Orden).FirstOrDefault();
}

<h1 class="mb-1">@ViewData["Title"]</h1>
<p class="text-muted mb-4">
    @if (esPieza)
    {
        <text>Revisá los datos de la pieza y confirmá. El taller se pone en contacto para coordinar el pago y la entrega.</text>
    }
    else
    {
        <text>Armá tu lámpara eligiendo campana, base y tipo de luz. El precio se calcula solo.</text>
    }
</p>

<form asp-action="Pedir" method="post" enctype="multipart/form-data">
    <div class="row g-4">

        @* ===== Columna izquierda: formulario ===== *@
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    @if (esPieza)
                    {
                        @* La pieza ya viene definida: no hay nada que elegir, solo se dejan notas *@
                        <input type="hidden" asp-for="LamparaId" />
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="MaterialCampanaId" class="form-label"></label>
                            <select asp-for="MaterialCampanaId" id="campana" class="form-select">
                                <option value="">Elegí una campana...</option>
                                @foreach (var c in Model.CampanasLista)
                                {
                                    <option value="@c.Id"
                                            data-precio="@c.PrecioBase.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            selected="@(Model.MaterialCampanaId == c.Id)">@c.Nombre · $ @c.PrecioBase.ToString("N2")</option>
                                }
                            </select>
                            <span asp-validation-for="MaterialCampanaId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaterialBaseId" class="form-label"></label>
                            <select asp-for="MaterialBaseId" id="base" class="form-select">
                                <option value="">Elegí una base...</option>
                                @foreach (var b in Model.BasesLista)
                                {
                                    <option value="@b.Id"
                                            data-precio="@b.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            selected="@(Model.MaterialBaseId == b.Id)">@b.TipoMaterial · $ @b.Precio.ToString("N2")</option>
                                }
                            </select>
                            <span asp-validation-for="MaterialBaseId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TipoLuzId" class="form-label"></label>
                            <select asp-for="TipoLuzId" asp-items="Model.TiposLuz" class="form-select">
                                <option value="">Elegí el tipo de luz...</option>
                            </select>
                            <span asp-validation-for="TipoLuzId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cantidad" class="form-label"></label>
                            <input asp-for="Cantidad" id="cantidad" type="number" min="1" max="10" class="form-control" style="max-width:140px;" />
                            <span asp-validation-for="Cantidad" class="text-danger"></span>
                        </div>
                    }

                    <div class="@(esPieza ? "mb-4" : "mb-3")">
                        <label asp-for="Observaciones" class="form-label"></label>
                        <textarea asp-for="Observaciones" rows="3" class="form-control"
                                  placeholder="@(esPieza ? "Cómo preferís coordinar la entrega o el retiro, algún comentario..." : "Para qué ambiente es, qué colores te gustan, plazos...")"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger"></span>
                    </div>

                    @if (!esPieza)
                    {
                        <div class="mb-4">
                            <label asp-for="Referencia" class="form-label"></label>
                            <input asp-for="Referencia" type="file" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                            <div class="form-text">Formatos: JPG, PNG o PDF. Máximo 5 MB.</div>
                            <span asp-validation-for="Referencia" class="text-danger"></span>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary btn-lg">Confirmar pedido</button>
                    @if (esPieza)
                    {
                        <a asp-controller="Catalogo" asp-action="Lamparas" class="btn btn-outline-secondary btn-lg">Volver al catálogo</a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                    }
                </div>
            </div>
        </div>

        @* ===== Columna derecha: resumen ===== *@
        <div class="col-lg-5">
            <div class="card">
                @if (esPieza)
                {
                    @if (foto != null)
                    {
                        <img src="@foto.RutaArchivo" class="card-img-top" style="height:240px;object-fit:cover;" alt="@Model.Lampara!.Nombre" />
                    }
                    <div class="card-body">
                        <h2 class="h4">@Model.Lampara!.Nombre</h2>
                        <p class="text-muted small mb-2">
                            @if (Model.Lampara.NumeroPieza != null)
                            {
                                <text>Pieza N.º @Model.Lampara.NumeroPieza · </text>
                            }
                            @Model.Lampara.Coleccion?.Nombre
                        </p>
                        <p class="small mb-3">
                            <strong>Campana:</strong> @Model.Lampara.MaterialCampana?.Nombre<br />
                            <strong>Base:</strong> @Model.Lampara.MaterialBase?.TipoMaterial
                        </p>
                        @if (!string.IsNullOrWhiteSpace(Model.Lampara.Descripcion))
                        {
                            <p class="small">@Model.Lampara.Descripcion</p>
                        }
                        <div class="d-flex justify-content-between align-items-baseline border-top pt-3">
                            <span>Precio de la pieza</span>
                            <span class="fs-4 fw-semibold">$ @Model.Lampara.Precio.ToString("N2")</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Cada pieza es única, por eso se pide de a una.</p>
                    </div>
                }
                else
                {
                    <div class="card-body">
                        <h2 class="h4">Tu lámpara a medida</h2>
                        <ul class="list-unstyled small mb-3">
                            <li><strong>Campana:</strong> <span id="res-campana" class="text-muted">sin elegir</span></li>
                            <li><strong>Base:</strong> <span id="res-base" class="text-muted">sin elegir</span></li>
                        </ul>
                        <div class="d-flex justify-content-between align-items-baseline border-top pt-3">
                            <span>Precio estimado</span>
                            <span class="fs-4 fw-semibold" id="res-total">$ 0,00</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0">(campana + base) × cantidad. El taller confirma el precio final.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (!esPieza)
    {
        <script>
            // Precio estimado en vivo. Es solo orientativo: el que vale lo calcula el servidor.
            (function () {
                var campana = document.getElementById('campana');
                var base = document.getElementById('base');
                var cantidad = document.getElementById('cantidad');
                var total = document.getElementById('res-total');
                var resCampana = document.getElementById('res-campana');
                var resBase = document.getElementById('res-base');

                function precio(select) {
                    var opcion = select.options[select.selectedIndex];
                    return opcion && opcion.dataset.precio ? parseFloat(opcion.dataset.precio) : 0;
                }
                function nombre(select) {
                    var opcion = select.options[select.selectedIndex];
                    return opcion && opcion.value ? opcion.text.split(' · ')[0] : 'sin elegir';
                }
                function actualizar() {
                    var cant = parseInt(cantidad.value, 10);
                    if (isNaN(cant) || cant < 1) cant = 1;
                    var suma = (precio(campana) + precio(base)) * cant;
                    total.textContent = '$ ' + suma.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    resCampana.textContent = nombre(campana);
                    resBase.textContent = nombre(base);
                }
                [campana, base, cantidad].forEach(function (el) {
                    el.addEventListener('change', actualizar);
                    el.addEventListener('input', actualizar);
                });
                actualizar();
            })();
        </script>
    }
}