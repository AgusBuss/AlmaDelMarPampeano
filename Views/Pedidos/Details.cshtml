@using Microsoft.AspNetCore.Mvc.Rendering
@model AlmaDelMarPampeano.Models.Pedido

@{
    var esAdmin = User.IsInRole("Administrador");
    ViewData["Title"] = $"Pedido #{Model.Id}";

    var nombreEstado = (Model.EstadoPedido?.NombreEstado ?? "").ToLowerInvariant();
    var cancelado = nombreEstado.Contains("cancel");
    var pasos = new[] { ("pend", "Pendiente"), ("produc", "En producción"), ("termin", "Terminado"), ("entreg", "Entregado") };
    var actual = Array.FindIndex(pasos, p => nombreEstado.Contains(p.Item1));
    var esPendiente = Model.EstadoPedido?.NombreEstado == "Pendiente";
    var puedeModificar = esAdmin || esPendiente;
    var mensajeEstado = cancelado ? null
        : nombreEstado.Contains("entreg") ? "¡Gracias por elegirnos! Tu lámpara ya fue entregada."
        : nombreEstado.Contains("termin") ? "Tu lámpara está lista. El taller te contacta para coordinar la entrega o el retiro."
        : nombreEstado.Contains("produc") ? "Tu lámpara se está haciendo. Cada pieza lleva su tiempo."
        : "Recibimos tu pedido. El taller se pone en contacto para confirmar el precio, el plazo y la forma de pago.";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
    <h1 class="mb-0">Pedido #@Model.Id</h1>
    <partial name="_EstadoBadge" model="@(Model.EstadoPedido?.NombreEstado ?? "")" />
</div>
<p class="text-muted mb-4">Realizado el @Model.FechaSolicitud.ToString("dd/MM/yyyy 'a las' HH:mm")</p>

@if (esAdmin)
{
    <p class="mb-4">Cliente: <strong>@ViewBag.EmailCliente</strong></p>
}

@* ===== Avance del pedido ===== *@
@if (cancelado)
{
    <div class="alert alert-danger">Este pedido fue cancelado.</div>
}
else
{
    <ol class="pedido-pasos">
        @for (var i = 0; i < pasos.Length; i++)
        {
            var clase = i < actual ? "hecho" : (i == actual ? "actual" : "");
            <li class="@clase">@pasos[i].Item2</li>
        }
    </ol>
}

@if (mensajeEstado != null)
{
    <div class="alert alert-info">@mensajeEstado</div>
}

<div class="row g-4">
    <div class="col-lg-8">

        @* ===== Qué se pidió ===== *@
        @foreach (var d in Model.Detalles)
        {
            var foto = d.Lampara?.Fotos.OrderBy(f => f.Orden).FirstOrDefault();
            <div class="card mb-3">
                <div class="row g-0">
                    @if (foto != null)
                    {
                        <div class="col-md-4">
                            <img src="@foto.RutaArchivo" class="img-fluid h-100 w-100" style="object-fit:cover;min-height:180px;border-radius:.75rem 0 0 .75rem;" alt="@d.Lampara!.Nombre" />
                        </div>
                    }
                    <div class="@(foto != null ? "col-md-8" : "col-12")">
                        <div class="card-body">
                            <h2 class="h4">@(d.Lampara?.Nombre ?? "Lámpara a medida")</h2>
                            @if (d.Lampara != null)
                            {
                                <p class="text-muted small mb-2">
                                    @if (d.Lampara.NumeroPieza != null)
                                    {
                                        <text>Pieza N.º @d.Lampara.NumeroPieza · </text>
                                    }
                                    Pieza del catálogo
                                </p>
                            }
                            <dl class="row mb-0 small">
                                <dt class="col-5 col-sm-4">Campana</dt>
                                <dd class="col-7 col-sm-8">@d.MaterialCampana?.Nombre</dd>
                                <dt class="col-5 col-sm-4">Base</dt>
                                <dd class="col-7 col-sm-8">@d.MaterialBase?.TipoMaterial</dd>
                                <dt class="col-5 col-sm-4">Tipo de luz</dt>
                                <dd class="col-7 col-sm-8">@(d.TipoLuz?.Nombre ?? "—")</dd>
                                <dt class="col-5 col-sm-4">Cantidad</dt>
                                <dd class="col-7 col-sm-8">@d.Cantidad</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Lo que nos contaste</h2>
                    <p class="mb-0" style="white-space:pre-wrap;">@Model.Observaciones</p>
                </div>
            </div>
        }

        @* ===== Archivos ===== *@
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Archivos</h2>

                @if (!Model.Archivos.Any())
                {
                    <p class="text-muted small">Todavía no hay archivos en este pedido.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var a in Model.Archivos)
                        {
                            <li class="list-group-item d-flex flex-wrap justify-content-between gap-2 px-0">
                                <span>
                                    <a href="@a.RutaArchivo" target="_blank" rel="noopener">@a.NombreArchivo</a>
                                    <span class="badge bg-secondary ms-1">@a.TipoDocumento</span>
                                </span>
                                <span class="text-muted small">@a.FechaSubida.ToString("dd/MM/yyyy")</span>
                            </li>
                        }
                    </ul>
                }

                <form asp-action="SubirArchivo" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
                    <input type="hidden" name="pedidoId" value="@Model.Id" />
                    <div class="col-sm">
                        <label class="form-label small mb-1" for="archivoSubido">Sumar un archivo (JPG, PNG o PDF, máx. 5 MB)</label>
                        <input id="archivoSubido" name="archivoSubido" type="file" class="form-control" accept=".jpg,.jpeg,.png,.pdf" required />
                    </div>
                    @if (esAdmin)
                    {
                        <div class="col-sm-4">
                            <label class="form-label small mb-1" for="tipoDocumento">Tipo</label>
                            <select id="tipoDocumento" name="tipoDocumento" class="form-select">
                                <option value="Referencia">Referencia</option>
                                <option value="Comprobante">Comprobante</option>
                                <option value="Presupuesto">Presupuesto</option>
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="tipoDocumento" value="Referencia" />
                    }
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-primary">Subir</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ===== Resumen y acciones ===== *@
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">Resumen</h2>
                <div class="d-flex justify-content-between align-items-baseline border-top pt-3">
                    <span>Total</span>
                    <span class="fs-4 fw-semibold">$ @Model.PrecioTotal.ToString("N2")</span>
                </div>
                <p class="text-muted small mt-2">El taller confirma el precio final y los plazos.</p>

                <div class="d-grid gap-2 mt-3">
                    @if (esAdmin)
                    {
                        <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" class="mb-2">
                            <label class="form-label small mb-1" for="estadoPedidoId">Estado del pedido</label>
                            <div class="input-group">
                                <select id="estadoPedidoId" name="estadoPedidoId" class="form-select"
                                        asp-items="(IEnumerable<SelectListItem>)ViewBag.Estados"></select>
                                <button type="submit" class="btn btn-primary">Guardar</button>
                            </div>
                        </form>
                    }
                    @if (puedeModificar)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            @(esAdmin ? "Editar notas" : "Editar mis notas")
                        </a>
                    }
                    @if (esPendiente)
                    {
                        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="form-eliminar d-grid"
                              data-titulo="¿Cancelar el pedido?"
                              data-mensaje="Se va a cancelar el pedido #@Model.Id."
                              data-boton="Sí, cancelar pedido"
                              data-volver="No, mantenerlo">
                            <button type="submit" class="btn btn-outline-danger">Cancelar pedido</button>
                        </form>
                    }
                    @if (esAdmin)
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-eliminar d-grid"
                              data-mensaje="Se va a eliminar definitivamente el pedido #@Model.Id.">
                            <button type="submit" class="btn btn-outline-secondary">Eliminar definitivamente</button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        @(esAdmin ? "Volver a los pedidos" : "Volver a mis pedidos")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>