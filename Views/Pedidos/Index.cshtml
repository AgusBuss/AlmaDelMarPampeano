@model IEnumerable<AlmaDelMarPampeano.Models.Pedido>

@{
    ViewData["Title"] = "Listado de Pedidos";
}

<h1>Listado de Pedidos</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Crear Nuevo Pedido</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Fecha</th>
            <th>Precio Total</th>
            <th>Observaciones</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@if (!Model.Any())
{
        <tr>
            <td colspan="5" class="text-center text-muted">Todavía no hay pedidos.</td>
        </tr>
}
@foreach (var item in Model) {
        <tr>
            <td>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
            <td>$ @item.PrecioTotal.ToString("0.00")</td>
            <td>@item.Observaciones</td>
            <td>@(item.EstadoPedido != null ? item.EstadoPedido.NombreEstado : "Sin estado")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                @if (User.IsInRole("Administrador") || item.EstadoPedido?.NombreEstado == "Pendiente")
                {
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                          class="form-eliminar d-inline"
                          data-mensaje="Se va a eliminar el pedido #@item.Id con todas sus lámparas y archivos.">
                        <button type="submit" class="btn btn-sm btn-danger">Borrar</button>
                    </form>
                }
            </td>
        </tr>
}
    </tbody>
</table>