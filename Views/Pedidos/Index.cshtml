@model IEnumerable<AlmaDelMarPampeano.Models.Pedido>

@{
    var esAdmin = User.IsInRole("Administrador");
    ViewData["Title"] = esAdmin ? "Pedidos" : "Mis pedidos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a asp-action="Pedir" class="btn btn-primary">Pedir una lámpara a medida</a>
</div>

@if (!Model.Any())
{
    <div class="cuaderno-tarjeta">
        <h2 class="h4">Todavía no hay pedidos</h2>
        <p class="mb-3">
            Elegí una pieza del catálogo o armá una lámpara a medida.
            Después vas a poder seguir acá el estado de tu pedido.
        </p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a asp-controller="Catalogo" asp-action="Index" asp-fragment="lamparas" class="btn btn-primary">Ver el catálogo</a>
            <a asp-action="Pedir" class="btn btn-outline-primary">Pedir a medida</a>
        </div>
    </div>
}
else
{
    <p class="text-muted">
        ¿Querés otra pieza? Elegila en el <a asp-controller="Catalogo" asp-action="Index" asp-fragment="lamparas">catálogo</a>
        o pedí una a medida.
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>N.º</th>
                    <th>Fecha</th>
                    <th>Lámpara</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var detalle = p.Detalles.FirstOrDefault();
                    var queSePidio = detalle?.Lampara?.Nombre ?? "Lámpara a medida";
                    if (p.Detalles.Count > 1) { queSePidio += $" y {p.Detalles.Count - 1} más"; }
                    var puedeEliminar = esAdmin || p.EstadoPedido?.NombreEstado == "Pendiente";

                    <tr>
                        <td>#@p.Id</td>
                        <td>@p.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@queSePidio</td>
                        <td><partial name="_EstadoBadge" model="@(p.EstadoPedido?.NombreEstado ?? "")" /></td>
                        <td class="text-end">$ @p.PrecioTotal.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Ver pedido</a>
                            @if (puedeEliminar)
                            {
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="form-eliminar d-inline"
                                      data-mensaje="Se va a eliminar el pedido #@p.Id.">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}