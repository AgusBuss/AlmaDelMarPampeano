@model AlmaDelMarPampeano.ViewModels.DetalleCreateViewModel

@{
    ViewData["Title"] = "Agregar Lámpara";
}

<h1>Agregar lámpara al Pedido #@Model.PedidoId</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="AgregarDetalle">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PedidoId" />

            <div class="form-group mb-3">
                <label asp-for="MaterialCampanaId" class="control-label"></label>
                <select asp-for="MaterialCampanaId" class="form-select" asp-items="Model.Campanas">
                    <option value="">-- Elegí una campana --</option>
                </select>
                <span asp-validation-for="MaterialCampanaId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MaterialBaseId" class="control-label"></label>
                <select asp-for="MaterialBaseId" class="form-select" asp-items="Model.Bases">
                    <option value="">-- Elegí una base --</option>
                </select>
                <span asp-validation-for="MaterialBaseId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" type="number" min="1" max="100" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Agregar al pedido" class="btn btn-success" />
                <a asp-action="Details" asp-route-id="@Model.PedidoId" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
