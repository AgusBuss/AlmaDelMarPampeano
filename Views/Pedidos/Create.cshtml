@model AlmaDelMarPampeano.ViewModels.PedidoCreateViewModel

@{
    ViewData["Title"] = "Nuevo Pedido";
}

<h1>Iniciar Nuevo Pedido</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Observaciones" class="control-label"></label>
                <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Ej: Entregar por la tarde..."></textarea>
                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>

            <p class="text-muted">El pedido se crea en estado <strong>Pendiente</strong>. Después vas a poder agregar las lámparas y subir archivos de referencia.</p>

            <div class="form-group mt-4">
                <input type="submit" value="Generar Pedido" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
