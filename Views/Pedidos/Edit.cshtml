@model AlmaDelMarPampeano.ViewModels.PedidoEditViewModel

@{
    ViewData["Title"] = "Editar Pedido";
}

<h1>Editar Pedido #@Model.Id</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            @if (Model.PuedeCambiarEstado)
            {
                <div class="form-group mb-3">
                    <label asp-for="EstadoPedidoId" class="control-label"></label>
                    <select asp-for="EstadoPedidoId" class="form-control" asp-items="Model.Estados"></select>
                    <span asp-validation-for="EstadoPedidoId" class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="control-label d-block">Estado del pedido</label>
                    <span class="badge bg-info text-dark">@Model.EstadoActual</span>
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="Observaciones" class="control-label"></label>
                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
