@model AlmaDelMarPampeano.ViewModels.RestablecerContrasenaViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<h1 class="mb-3">Restablecer contraseña</h1>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Restablecer" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="ContrasenaTemporal" class="form-label"></label>
                <input asp-for="ContrasenaTemporal" class="form-control" autocomplete="off" />
                <span asp-validation-for="ContrasenaTemporal" class="text-danger"></span>
                <div class="form-text">
                    Se muestra en texto visible para que puedas pasársela al cliente.
                    Tiene que cumplir las reglas de contraseña (mínimo 6 caracteres).
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Restablecer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}