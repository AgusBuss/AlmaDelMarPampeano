@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Ocurrió un error.</h1>
<h2 class="text-danger">No pudimos procesar tu solicitud. Probá de nuevo en unos minutos.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Código de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>