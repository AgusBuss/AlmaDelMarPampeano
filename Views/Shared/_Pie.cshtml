@inject IConfiguration Configuracion

@{
    var instagram = (Configuracion["Contacto:Instagram"] ?? "").Trim().TrimStart('@');
    var whatsapp = new string((Configuracion["Contacto:WhatsApp"] ?? "").Where(char.IsDigit).ToArray());
    var correo = (Configuracion["Contacto:Correo"] ?? "").Trim();
    var ciudad = (Configuracion["Contacto:Ciudad"] ?? "").Trim();
    var hayContacto = instagram != "" || whatsapp != "" || correo != "";
}

<footer class="pie">
    <div class="container pie-contenido">

        <div class="pie-marca">
            <strong>Alma del Mar Pampeano</strong>
            <span>Lámparas artesanales de roca, fósil y madera pampeana.</span>
            @if (ciudad != "")
            {
                <span>@ciudad</span>
            }
        </div>

        <nav class="pie-enlaces" aria-label="Enlaces del sitio">
            <a asp-controller="Catalogo" asp-action="Index">Inicio</a>
            <a asp-controller="Catalogo" asp-action="Lamparas">Lámparas</a>
            <a asp-controller="Catalogo" asp-action="Index" asp-fragment="cuadernos">Cuadernos</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Pedidos" asp-action="Index">Mis pedidos</a>
            }
        </nav>

        @if (hayContacto)
        {
            <div class="pie-contacto">
                <strong>Contacto</strong>

                @if (instagram != "")
                {
                    <a href="https://instagram.com/@Uri.EscapeDataString(instagram)" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                        </svg>
                        <span>@@@instagram</span>
                    </a>
                }

                @if (whatsapp != "")
                {
                    <a href="https://wa.me/@whatsapp" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                        </svg>
                        <span>WhatsApp</span>
                    </a>
                }

                @if (correo != "")
                {
                    <a href="mailto:@correo">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                        </svg>
                        <span>@correo</span>
                    </a>
                }
            </div>
        }
    </div>

    <div class="pie-copy">&copy; 2026 Alma del Mar Pampeano</div>
</footer>