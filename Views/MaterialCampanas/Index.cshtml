@model IEnumerable<AlmaDelMarPampeano.Models.MaterialCampana>

@{
    ViewData["Title"] = "Campanas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Campanas</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva campana</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HistoriaOrigen)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PrecioBase)
                </th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(model => item.HistoriaOrigen)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PrecioBase)
                </td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                          class="form-eliminar d-inline"
                          data-mensaje="Se va a eliminar la campana &quot;@item.Nombre&quot;.">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>