@model IEnumerable<AlmaDelMarPampeano.Models.EstadoPedido>

@{
    ViewData["Title"] = "Estados de pedido";
}

<h1>Estados de pedido</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo estado</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreEstado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NombreEstado)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                      class="form-eliminar d-inline"
                      data-mensaje="Se va a eliminar el estado &quot;@item.NombreEstado&quot;.">
                    <button type="submit" class="btn btn-link p-0 align-baseline text-danger">Eliminar</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>