@model AlmaDelMarPampeano.Models.EstadoPedido

@{
    ViewData["Title"] = "Eliminar estado";
}

<h1>Eliminar estado</h1>

<h3>¿Estás seguro de que querés eliminar este estado?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NombreEstado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NombreEstado)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </form>
</div>