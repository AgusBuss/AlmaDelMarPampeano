@model IEnumerable<AlmaDelMarPampeano.Models.Auditoria>

@{
    ViewData["Title"] = "Auditoría";
}

<h1>Auditoría del sistema</h1>
<p class="text-muted">Registro de qué usuario realizó cada operación. Se muestran las últimas 200.</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="usuario" value="@ViewData["Usuario"]" class="form-control" placeholder="Filtrar por usuario (email)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Fecha y hora</th>
            <th>Usuario</th>
            <th>Operación</th>
            <th>Detalle</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No hay registros de auditoría.</td>
            </tr>
        }
        @foreach (var item in Model)
        {
            var clase = item.TipoAccion == "Crear" ? "bg-success"
                      : item.TipoAccion == "Eliminar" ? "bg-danger"
                      : "bg-warning text-dark";
            <tr>
                <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@item.UsuarioEmail</td>
                <td><span class="badge @clase">@item.TipoAccion</span></td>
                <td>@item.AccionRealizada</td>
            </tr>
        }
    </tbody>
</table>